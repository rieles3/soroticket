              "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
              "if (pm.response.code !== 401) { pm.execution.setNextRequest(null); } else {",
              "const data = pm.response.json();",
              "pm.collectionVariables.unset('api_key'); pm.collectionVariables.unset('password');",
              "}"
            ]
          }
        }
      ]
    }
  ]
}
