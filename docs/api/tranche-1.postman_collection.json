{
  "info": {
    "name": "Soroticket T1 — Burn and Tally (testnet)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Synthetic fixtures only. Run sequentially with a 1500 ms request delay and 100000 ms request timeout. New tenant each run. For independent RPC, signature and privacy verification also run npm run e2e:cloud."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8787"
    }
  ],
  "item": [
    {
      "name": "Ready",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Env",
            "value": "test"
          }
        ],
        "url": "{{base_url}}/readyz"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const run=pm.variables.replaceIn('{{$guid}}'); pm.collectionVariables.set('run',run); pm.collectionVariables.set('password',pm.variables.replaceIn('{{$guid}}')); pm.collectionVariables.set('fund_attempt',0);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); } else {",
              "const data = pm.response.json();",
              "pm.test('testnet only',()=>pm.expect(data.network).to.eql('testnet')); pm.collectionVariables.set('contract_id',data.contract_id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Sign up",
