    {
      "name": "Wait for testnet funding",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Env",
            "value": "test"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{api_key}}"
          }
        ],
        "url": "{{base_url}}/v1/overview"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); } else {",
              "const data = pm.response.json();",
              "if (!data.account_funded) { const attempt=Number(pm.collectionVariables.get('fund_attempt'))+1; pm.collectionVariables.set('fund_attempt',attempt); pm.test('funded within 60 polls',()=>pm.expect(attempt).to.be.below(60)); pm.execution.setNextRequest(attempt<60 ? 'Wait for testnet funding' : null); }",
              "}"
            ]
          }
        }
      ]
    },
